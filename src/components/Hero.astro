---
// AFRIMMAK — Hero. Ported from ui_kits/website/Hero.jsx.
// Paper-white hero: a full-bleed photo behind a solid copy capsule.
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero-students.jpg';
---

<header class="hero">
  <!-- Full-bleed hero photograph behind the copy capsule. Optimized responsive
       variants (WebP srcset) are generated at build by Astro's <Image />. -->
  <div class="hero__photo">
    <Image
      src={heroPhoto}
      alt="Young students seated together in a hall during a schools event"
      class="hero__photo-img"
      widths={[480, 768, 1200, 1600, 2000, 2560]}
      sizes="100vw"
      quality={72}
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__photo-scrim" aria-hidden="true"></div>
  </div>

  <div class="afr-container hero__inner">
    <div class="hero__capsule">
      <h1 class="h-display" style="margin: 0; color: var(--ink-900);">
        Skills, mentorship,<br class="hero__br" />
        and a real shot —<br class="hero__br" />
        <span style="color: var(--afr-blue);">for young Gambians.</span>
      </h1>

      <p class="lede" style="margin-top: 24px; max-width: 540px;">
        Afrimmak empowers young Africans through an entrepreneurship and
        innovation competition — a platform to showcase ideas, find mentorship,
        connect with industry leaders, and compete for funding and support.
      </p>

      <div class="hero__ctas">
        <a href="/competition" class="btn btn-primary btn-lg">
          Learn more
          <i data-lucide="arrow-right"></i>
        </a>
        <a href="/contact" class="btn btn-ghost btn-lg">Get in touch</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 720px;
    padding-top: 180px;
    padding-bottom: 120px;
    background: var(--paper);
    overflow: hidden;
  }
  .hero__photo {
    position: absolute;
    inset: 24px;
    border-radius: 32px;
    background: var(--ink-100);
    overflow: hidden;
    pointer-events: none;
  }
  .hero__photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Soft navy scrim: grounds the busy photo and lifts the capsule off it. */
  .hero__photo-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 26, 51, 0.28) 0%, rgba(10, 26, 51, 0.05) 45%, transparent 70%),
      linear-gradient(0deg, rgba(10, 26, 51, 0.18), transparent 40%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 640px);
  }
  .hero__capsule {
    background: white;
    border: 1px solid var(--ink-100);
    border-radius: 28px;
    padding: 40px 44px 44px;
    box-shadow: 0 24px 64px rgba(10, 26, 51, 0.1);
  }
  .hero__ctas {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .hero { padding-top: 140px; padding-bottom: 80px; min-height: 0; }
    .hero__capsule { padding: 28px 24px 32px; }
    /* Drop the forced line breaks so the headline wraps naturally instead of
       overflowing the capsule at 320-375px. */
    .hero__br { display: none; }
  }
</style>

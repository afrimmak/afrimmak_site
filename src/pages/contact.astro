---
import BaseLayout from '../layouts/BaseLayout.astro';

const enquiries = [
  { label: 'The competition', how: 'Use the form — we\'ll tell you when the next cycle opens', dot: 'var(--afr-red)' },
  { label: 'Partnerships & funding', how: 'info@afrimmak.org — we reply within 3 working days', dot: 'var(--afr-blue)' },
  { label: 'Media & press', how: "info@afrimmak.org with 'Press' in the subject", dot: 'var(--afr-green)' },
  { label: 'Volunteer with us', how: 'Use the form — tell us how you would like to help', dot: 'var(--ink-500)' },
];
---

<BaseLayout
  current="Contact"
  title="Contact — Afrimmak"
  description="Get in touch with Afrimmak about the competition, partnerships and funding, media, or volunteering — a real team in The Gambia that replies personally."
>
  <section class="page-head page-head--red">
    <div class="afr-container">
      <div class="eyebrow" style="color: white;">Contact</div>
      <h1 class="h-display" style="margin: 8px 0 16px; color: white;">Let's talk.</h1>
      <p class="lede" style="max-width: 560px; color: rgba(255,255,255,0.9);">
        Whether you want to know more about the competition, explore a partnership,
        or just want to say hello — we're a real team and we respond personally.
      </p>
    </div>
  </section>

  <section class="tight">
    <div class="afr-container contact-grid">
      <!-- Form -->
      <div class="card contact-form">
        <div id="cf-form-wrap">
          <h2 class="h3" style="font-size: 22px; margin: 0 0 4px;">Send us a message</h2>
          <p style="margin: 0 0 24px; color: var(--ink-500); font-size: 14px;">We read every message and respond within two working days.</p>
          <form class="form" id="contact-form" novalidate>
            <div class="form__row">
              <label class="field">
                <span>First name</span>
                <input type="text" name="firstName" id="cf-first" autocomplete="given-name" placeholder="Your first name" aria-describedby="err-first" />
                <small class="field__error" id="err-first" data-error-for="cf-first"></small>
              </label>
              <label class="field">
                <span>Last name</span>
                <input type="text" name="lastName" id="cf-last" autocomplete="family-name" placeholder="Your last name" aria-describedby="err-last" />
                <small class="field__error" id="err-last" data-error-for="cf-last"></small>
              </label>
            </div>
            <label class="field">
              <span>Email address</span>
              <input type="email" name="email" id="cf-email" autocomplete="email" placeholder="you@example.com" aria-describedby="err-email" />
              <small class="field__error" id="err-email" data-error-for="cf-email"></small>
            </label>
            <label class="field">
              <span>WhatsApp / phone (optional)</span>
              <input type="tel" name="phone" id="cf-phone" autocomplete="tel" placeholder="+220 …" />
            </label>
            <label class="field">
              <span>What's this about?</span>
              <select name="topic" id="cf-topic" aria-describedby="err-topic">
                <option value="" disabled selected>Choose a topic</option>
                <option>The competition</option>
                <option>Becoming a partner</option>
                <option>Funding or donations</option>
                <option>Mentorship (I want to mentor)</option>
                <option>Media or press</option>
                <option>Volunteering</option>
                <option>Something else</option>
              </select>
              <small class="field__error" id="err-topic" data-error-for="cf-topic"></small>
            </label>
            <label class="field">
              <span>Message</span>
              <textarea name="message" id="cf-message" rows="5" placeholder="Tell us what's on your mind." aria-describedby="err-message"></textarea>
              <small class="field__error" id="err-message" data-error-for="cf-message"></small>
            </label>

            <!-- Honeypot: positioned off-screen (NOT display:none), unlabelled and
                 hidden from assistive tech. A bot that autofills "website" is
                 silently dropped (fake success, nothing sent). -->
            <div class="hp-field" aria-hidden="true">
              <input type="text" name="website" id="cf-website" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary btn-lg form__submit" style="width: 100%; justify-content: center;">Send message</button>
            <p class="form__note" style="text-align: center; font-size: 12px; color: var(--ink-500); margin: 4px 0 0;">Your message goes to the Afrimmak team. We don't share your details.</p>
            <p class="form__error-banner" id="cf-error" role="alert" hidden></p>
          </form>
        </div>

        <!-- Success state — shown in place of the form after a successful submit -->
        <div class="form-success" id="cf-success" role="status" hidden>
          <div class="form-success__icon"><i data-lucide="check"></i></div>
          <h2 class="h3" style="font-size: 22px; margin: 0 0 8px;">Thanks — message received.</h2>
          <p style="margin: 0; color: var(--ink-700);">We've received your message and will reply within 2 working days.</p>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="contact-side">
        <div class="card contact-wa" id="donate">
          <div class="eyebrow on-dark">Fastest way</div>
          <div style="font-family: var(--font-display); font-weight: 900; font-size: 24px; color: white; margin: 4px 0;">WhatsApp</div>
          <div style="font-family: var(--font-display); font-weight: 800; font-size: 16px; color: var(--green-400); margin-bottom: 12px;">+220 3869939</div>
          <p style="color: rgba(255,255,255,0.7); font-size: 13px; margin: 0 0 18px;">We respond fast during Gambian working hours — usually within a few hours.</p>
          <a href="https://wa.me/2203869939" class="btn btn-secondary btn-sm">Open WhatsApp <i data-lucide="arrow-right"></i></a>
        </div>

        <div class="card">
          <div class="eyebrow">By enquiry type</div>
          <div class="enq">
            {enquiries.map((e) => (
              <div class="enq__row">
                <span class="enq__dot" style={`background: ${e.dot};`}></span>
                <div>
                  <div class="enq__label">{e.label}</div>
                  <div class="enq__how">{e.how}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="card" style="background: var(--paper-warm);">
          <div class="eyebrow">Where to find us</div>
          <div class="loc"><i data-lucide="map-pin"></i><div><strong>Address</strong><br />Brusubi Phase 1, Banjul, The Gambia</div></div>
          <div class="loc"><i data-lucide="mail"></i><div><strong>Email</strong><br />info@afrimmak.org</div></div>
          <div class="loc"><i data-lucide="phone"></i><div><strong>Phone</strong><br />+220 3869939</div></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // ============================================================
    //  ⚠️  CONTACT FORM ENDPOINT — REPLACE THIS PLACEHOLDER URL  ⚠️
    //  Paste your deployed Google Apps Script Web App URL below.
    //  This is the ONLY place the endpoint is defined.
    // ============================================================
    const FORM_ENDPOINT = "https://script.google.com/macros/s/AKfycbzScqW03Urp00feubzGcDXzjuEVUDPB_QrIvS6o5kre7448qME8NLWRpz6qTBWEkoWC/exec"; // <-- PLACEHOLDER: replace with the real URL

    const form = document.getElementById('contact-form');
    if (form) {
      const wrap = document.getElementById('cf-form-wrap');
      const success = document.getElementById('cf-success');
      const banner = document.getElementById('cf-error');
      const submitBtn = form.querySelector('.form__submit');
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      // Required fields -> [id, message shown when empty]. Phone is optional.
      const required = [
        ['cf-first', 'Please enter your first name.'],
        ['cf-last', 'Please enter your last name.'],
        ['cf-email', 'Please enter your email address.'],
        ['cf-topic', 'Please choose a topic.'],
        ['cf-message', 'Please write a short message.'],
      ];

      const getVal = (id) => {
        const e = document.getElementById(id);
        return e ? String(e.value || '').trim() : '';
      };
      const setError = (id, msg) => {
        const input = document.getElementById(id);
        const err = form.querySelector('[data-error-for="' + id + '"]');
        if (err) err.textContent = msg || '';
        if (input) {
          input.classList.toggle('is-invalid', !!msg);
          if (msg) input.setAttribute('aria-invalid', 'true');
          else input.removeAttribute('aria-invalid');
        }
      };

      const validate = () => {
        let firstInvalid = '';
        required.forEach(([id, msg]) => {
          if (!getVal(id)) { setError(id, msg); if (!firstInvalid) firstInvalid = id; }
          else setError(id, '');
        });
        const email = getVal('cf-email');
        if (email && !EMAIL_RE.test(email)) {
          setError('cf-email', 'Please enter a valid email address.');
          if (!firstInvalid) firstInvalid = 'cf-email';
        }
        if (firstInvalid) { const el = document.getElementById(firstInvalid); if (el) el.focus(); }
        return !firstInvalid;
      };

      const showSuccess = () => {
        if (wrap) wrap.hidden = true;
        if (success) { success.hidden = false; success.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        form.reset();
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (banner) banner.hidden = true;

        // Honeypot: a filled "website" field means a bot. Fake success, send nothing.
        if (getVal('cf-website') !== '') { showSuccess(); return; }

        if (!validate()) return;

        const payload = {
          firstName: getVal('cf-first'),
          lastName: getVal('cf-last'),
          email: getVal('cf-email'),
          phone: getVal('cf-phone'),
          topic: getVal('cf-topic'),
          message: getVal('cf-message'),
        };

        const label = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

        try {
          await fetch(FORM_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload),
          });
          // no-cors -> the response is opaque and cannot be read. If fetch did not
          // throw, treat the submission as sent (a real limitation of this approach).
          showSuccess();
        } catch (err) {
          if (banner) {
            banner.innerHTML = 'Something went wrong. Please email us directly at <a href="mailto:info@afrimmak.org">info@afrimmak.org</a>.';
            banner.hidden = false;
          }
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = label; }
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .page-head { padding-top: 156px; padding-bottom: 64px; background: var(--paper); }
  .page-head--red { background: var(--afr-red); }

  .contact-grid { display: grid; grid-template-columns: 1fr 400px; gap: 48px; align-items: start; }
  .contact-form { padding: 36px; }
  .form { display: flex; flex-direction: column; gap: 18px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field span { font-family: var(--font-display); font-weight: 700; font-size: 13px; color: var(--ink-900); }
  .field input, .field select, .field textarea {
    padding: 12px 14px;
    border: 1px solid var(--ink-200);
    border-radius: 10px;
    font-family: var(--font-body);
    /* 16px minimum: anything smaller makes iOS Safari auto-zoom on focus, which
       is a jarring mobile bug. Do not drop this below 16px. */
    font-size: 16px;
    color: var(--ink-900);
    background: var(--paper-warm);
    outline: none;
    transition: border-color 160ms var(--ease-out);
    resize: vertical;
  }
  /* Comfortable one-handed textarea. */
  .field textarea { min-height: 120px; line-height: 1.55; }

  /* Inline validation */
  .field__error {
    display: block;
    margin-top: 5px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--afr-red);
  }
  .field__error:empty { display: none; }
  .field input.is-invalid, .field select.is-invalid, .field textarea.is-invalid {
    border-color: var(--afr-red);
    background: var(--red-50);
  }

  /* Honeypot — off-screen, never shown to humans (deliberately NOT display:none). */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px; height: 1px;
    overflow: hidden;
  }

  /* Network / server failure banner */
  .form__error-banner {
    margin: 4px 0 0;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--red-50);
    border: 1px solid var(--red-100);
    color: var(--red-700);
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
  }
  .form__error-banner a { color: var(--red-700); font-weight: 600; }

  /* Success state */
  .form-success { text-align: center; padding: 24px 8px; }
  .form-success__icon {
    width: 56px; height: 56px; border-radius: 999px;
    background: var(--green-50); color: var(--green-600);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
  }
  .form-success__icon :global(svg) { width: 30px; height: 30px; stroke-width: 2; }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--afr-blue); background: white; }

  .contact-side { display: flex; flex-direction: column; gap: 20px; }
  .contact-wa { background: var(--ink-900); }

  .enq { display: flex; flex-direction: column; gap: 0; margin-top: 8px; }
  .enq__row { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; padding: 12px 0; border-bottom: 1px solid var(--ink-100); }
  .enq__row:last-child { border-bottom: none; }
  .enq__dot { width: 8px; height: 8px; border-radius: 999px; margin-top: 7px; }
  .enq__label { font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--ink-900); }
  .enq__how { font-size: 13px; color: var(--ink-500); }

  .loc { display: flex; gap: 10px; align-items: flex-start; margin-top: 14px; font-size: 13px; color: var(--ink-700); }
  .loc:first-of-type { margin-top: 12px; }
  .loc :global(svg) { width: 18px; height: 18px; color: var(--afr-blue); flex: 0 0 18px; margin-top: 2px; }
  .loc strong { font-family: var(--font-display); font-weight: 700; color: var(--ink-900); }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: 32px; }
    .form__row { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .contact-form { padding: 22px 20px; }
  }
</style>
